Nạp hồ sơ vay lên production lộ ra đúng lỗ hổng này: 50F-034.37 đã bán và giao ngày
10/08/2026, tài khoản xe đã ngưng, nhưng vòng đời trong hệ thống vẫn ghi "đang khai thác"
– nên cảnh báo "xe đã ra khỏi đội nhưng còn là tài sản bảo đảm" im lặng đúng chiếc xe
đáng lo nhất. Nay xét cả hai dấu hiệu: vòng đời khác "đang khai thác" HOẶC xe đã ngưng.

Cảnh báo nói rõ "vòng đời chưa cập nhật" để người đọc biết phải sửa hồ sơ xe chứ không
tưởng là hệ thống đã có đủ dữ liệu.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UnhZiuFEAVHRb7fXj8xVrx
---
 backend/app/services/finance.py       |  9 +++++++--
 backend/tests/test_vay_the_chap_xe.py | 13 +++++++++++++
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/backend/app/services/finance.py b/backend/app/services/finance.py
index 1c9b027..8a3625e 100644
--- a/backend/app/services/finance.py
+++ b/backend/app/services/finance.py
@@ -229,10 +229,15 @@ def vay_xe(db: Session, hom_nay: date | None = None) -> dict:
     for vid, ds in gan_xe.items():
         v = xe.get(vid)
         if v is None: continue
-        if v.lifecycle and v.lifecycle != "dang_khai_thac":
+        # Xét CẢ hai dấu hiệu. Một chiếc xe bị ngưng khai thác mà vòng đời chưa ai cập nhật vẫn là xe
+        # đã ra khỏi đội trên thực tế – 50F-034.37 đã giao ngày 10/08 chính là trường hợp đó, và nếu chỉ
+        # nhìn vòng đời thì cảnh báo quan trọng nhất lại im lặng đúng lúc cần kêu.
+        ra_khoi_doi = (v.lifecycle and v.lifecycle != "dang_khai_thac") or not v.active
+        if ra_khoi_doi:
+            trang_thai = v.lifecycle if v.lifecycle and v.lifecycle != "dang_khai_thac" else "đã ngưng khai thác, vòng đời chưa cập nhật"
             for g in ds:
                 canh_bao.append({"muc": "gap", "loai": "xe_da_ra_khoi_doi_van_the_chap", "khe_uoc": g["code"], "xe": v.plate,
-                                 "noi_dung": f"Xe {v.plate} trạng thái '{v.lifecycle}' nhưng vẫn là tài sản bảo đảm của khế ước {g['contract_no'] or g['code']} ({g['partner']}, dư nợ {g['du_no']:,.0f}đ)",
+                                 "noi_dung": f"Xe {v.plate} trạng thái '{trang_thai}' nhưng vẫn là tài sản bảo đảm của khế ước {g['contract_no'] or g['code']} ({g['partner']}, dư nợ {g['du_no']:,.0f}đ)",
                                  "viec": "Xin văn bản giải chấp riêng của ngân hàng trước khi sang tên, hoặc tất toán khế ước"})
 
     # Xe đang khai thác không gắn khế ước nào.
diff --git a/backend/tests/test_vay_the_chap_xe.py b/backend/tests/test_vay_the_chap_xe.py
index 497590a..ab97d45 100644
--- a/backend/tests/test_vay_the_chap_xe.py
+++ b/backend/tests/test_vay_the_chap_xe.py
@@ -155,3 +155,16 @@ def test_v9_nap_ho_so_khe_uoc_chay_lai_khong_tao_trung():
     # xe đã bán vẫn là tài sản bảo đảm → phải kêu gấp
     assert [c for c in d["canh_bao"] if c.get("xe") == "50F-046.92" and c["muc"] == "gap"]
     assert client.post("/api/v1/fin/vay-xe/nap", json=body, headers=login("hcns")).status_code == 403
+
+
+def test_v10_xe_ngung_khai_thac_ma_vong_doi_chua_cap_nhat_van_phai_keu():
+    """50F-034.37 trong hồ sơ thật: đã giao cho người mua, tài khoản xe bị ngưng, nhưng vòng đời vẫn
+    ghi 'đang khai thác'. Nếu chỉ nhìn vòng đời thì cảnh báo quan trọng nhất im lặng đúng lúc cần kêu."""
+    from app.db.session import SessionLocal
+    from app.models.hr import Vehicle
+    db = SessionLocal()
+    v = db.query(Vehicle).filter(Vehicle.plate == "50F-034.71").first()
+    v.active = False; v.lifecycle = "dang_khai_thac"; db.commit(); db.close()
+    d = _lay()
+    cb = [c for c in d["canh_bao"] if c.get("xe") == "50F-034.71"]
+    assert cb and cb[0]["muc"] == "gap" and "chưa cập nhật" in cb[0]["noi_dung"]
