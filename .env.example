# ---- chung ----
ENV=dev                      # dev | prod
DB_PASSWORD=vtos_local_2026
SECRET_KEY=doi-khoa-nay-truoc-khi-chay-that   # openssl rand -hex 32
ROBOT_TOKEN=doi-robot-token                  # openssl rand -hex 16
SEED_DEMO=1                  # 0 khi chạy thật
CORS_ORIGINS=http://localhost:3000
# ---- Meta Conversions API: báo ngược doanh thu thật lên Facebook ----
# Thiếu hai dòng đầu thì bộ gửi ĐỨNG IM: không gọi mạng, không đổi trạng thái dòng nào, và
# cửa GET /api/v1/dau-quang-cao/chuyen-doi/cau-hinh-meta nói ra đang thiếu gì.
#
# HẠN CHÓT CÓ THẬT: Meta chỉ nhận chuyển đổi trong 7 NGÀY kể từ lúc khách chốt tour. Mỗi ngày
# hai dòng này còn rỗng là một ngày doanh thu vĩnh viễn không quy công tự động được.
FB_DATASET_ID=                 # ID Dataset/Pixel trong Trình quản lý sự kiện của Meta
FB_CAPI_TOKEN=                 # token có quyền ads_management trên Dataset ấy.
                               # KHÔNG dùng lại FB_PAGE_ACCESS_TOKEN của Messenger: token Trang
                               # không có quyền này, và Meta trả lỗi QUYỀN - đọc rất giống lỗi
                               # dữ liệu, mất nửa ngày mới lần ra.
FB_CAPI_VERSION=v25.0          # bản Graph API; đổi khi Meta ngừng hỗ trợ bản này
FB_CAPI_EVENT_NAME=Purchase    # đổi nếu Phòng MKT dựng phễu nhiều bậc trên Trình quản lý sự kiện
FB_CAPI_ACTION_SOURCE=         # để rỗng = tự suy. VTOS chưa ghi được cách chốt (gọi điện / nhắn
                               # tin / tới văn phòng) nên mặc định là "other" - giá trị Meta để
                               # dành cho đúng tình huống không biết. Điền nếu MKT biết rõ hơn.
FB_CAPI_TEST_EVENT_CODE=       # bật tạm để thử trên Trình kiểm tra sự kiện; sự kiện thử KHÔNG
                               # vào báo cáo. NHỚ XOÁ sau khi thử xong.

# ---- chỉ prod ----
DOMAIN=vtos.infinitytours.org   # tên miền chính thức: infinitytours.org (web+API tại vtos., n8n tại n8n.vtos.)
ACME_EMAIL=vietourist266@gmail.com
